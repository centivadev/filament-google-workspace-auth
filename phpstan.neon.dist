parameters:
    paths:
        - src
        - tests

    level: 6

    # src/ is analysed with no suppressions. These cover three Pest/Mockery idioms in tests/ that
    # PHPStan cannot model: $this resolves to TestCall inside a Pest closure,
    # shouldReceive() is typed as a union that does not declare once(), and traits applied
    # with Pest's uses() look unused.
    # Unmatched entries are reported as errors, so these cannot rot.
    ignoreErrors:
        -
            identifier: method.notFound
            paths:
                - tests
        -
            identifier: argument.type
            paths:
                - tests
        -
            identifier: trait.unused
            paths:
                - tests/Fixtures/EnablesPendingAccess.php
                - tests/Fixtures/DisablesPendingAccess.php
