parameters:
    paths:
        - src
        - tests

    level: 6

    # src/ is analysed with no suppressions. These cover two Pest/Mockery idioms in tests/ that
    # PHPStan cannot model: $this resolves to TestCall inside a Pest closure, and
    # shouldReceive() is typed as a union that does not declare once().
    # Unmatched entries are reported as errors, so these cannot rot.
    ignoreErrors:
        -
            identifier: method.notFound
            paths:
                - tests
        -
            identifier: argument.type
            paths:
                - tests
